# Leave everything blank to run in demo mode (realistic sample data, no keys needed).

# Real flights + stays. Sign up free at https://app.duffel.com and use a TEST token (starts with duffel_test_).
DUFFEL_TOKEN=

# Real activity ideas written by Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Share links for "plan with friends". Free database at https://upstash.com (create a Redis database, copy the REST URL and token).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: your email or site, sent to Wikipedia/Wikivoyage so they rate-limit this app less.
# (Popular cities use pre-built guides in public/guides and don't need it.)
WIKIMEDIA_CONTACT=

# Optional: real photos, ratings and reviews for hotels, restaurants and sights.
# Google Cloud console → enable "Places API (New)" → create an API key. Paid, with a free monthly allowance.
GOOGLE_PLACES_API_KEY=

# Optional: send "Email this plan" emails. Free account at https://resend.com → API Keys.
# Without a verified domain, Resend only delivers to your own Resend login email.
RESEND_API_KEY=
RESEND_FROM=

# Optional: real flight fares (free). Sign up at https://www.travelpayouts.com, then Profile → API token.
# TRAVELPAYOUTS_MARKER is your partner ID (adds it to the exact-fare links so bookings credit you).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
